      "post": {
        "summary": "Create marketplace order",
        "operationId": "post-orders",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "type": "object",
                  "x-examples": {
                    "example-1": {
                      "OrderNumber": 123,
                      "Order": {}
                    }
                  },
                  "properties": {
                    "E37OrderNumber": {
                      "type": "integer",
                      "description": "Order number for the newly created order in E37.",
                      "example": 112233,
                      "readOnly": true
                    }
                  },
                  "required": [
                    "E37OrderNumber"
                  ]
                },
                "examples": {
                  "example-1": {
                    "value": {
                      "E37OrderNumber": 112233
                    }
                  }
                }
              }
            }
          },

    "/orders/{id}": {
      "parameters": [
        {
          "schema": {
            "type": "integer"
          },
          "name": "id",
          "in": "path",
          "required": true,
          "description": "E37 order number"
        }
      ],
      "get": {
        "summary": "Get order",
        "tags": [
          "Orders"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "operationId": "get-orders-id",
        "description": "Get information about an order."
      }
    },
    "/orders/{id}/status": {
      "get": {
        "summary": "Get order status",
        "tags": [
          "Orders"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "type": "object",
                  "x-examples": {
                    "example-1": {
                      "ID": 7700,
                      "ExternalOrderNumber": "EXT-ORDER-1",
                      "OrderStatus": {
                        "ID": 1,
                        "Name": "NewOrder"
                      }
                    }
                  },
                  "properties": {
                    "ID": {
                      "type": "integer",
                      "description": "E37 order number"
                    },
                    "ExternalOrderNumber": {
                      "type": "string",
                      "description": "External order number, if external order."
                    },
                    "OrderStatus": {
                      "type": "object",
                      "description": "Information about the current order status.",
                      "required": [
                        "ID",
                        "Name"
                      ],
                      "properties": {
                        "ID": {
                          "type": "integer",
                          "description": "* 1: NewOrder\n* 2: Cancelled\n* 3: Delivered\n* 4: PackingSlipPrinted\n* 5: ChangeOrder\n* 6: PartiallyDelivered\n* -1: Custom\n"
                        },
                        "Name": {
                          "type": "string",
                          "description": "String representation of the order status."
                        }
                      }
                    }
                  },
                  "required": [
                    "ID",
                    "OrderStatus"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "operationId": "get-orders-7700-status",
        "description": "Get current order status for order."
      },
      "parameters": [
        {
          "schema": {
            "type": "integer"
          },
          "name": "id",
          "in": "path",
          "required": true,
          "description": "E37 order number"
        }
      ]
    },
